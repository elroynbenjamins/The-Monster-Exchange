{
  "name": "com.elroybenjamins.themonsterexchange",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Monster Exchange: data-driven monster collecting, breeding, battling, and market simulation.",
  "scripts": {
    "play": "node --experimental-strip-types src/cli.ts",
    "dev": "node --watch --experimental-strip-types src/demo.ts",
    "start": "node --experimental-strip-types src/demo.ts",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "check": "node --experimental-strip-types scripts/validate-content.ts",
    "audit:design": "node --experimental-strip-types scripts/audit-design-v18.ts",
    "monsterdex": "node --experimental-strip-types scripts/serve-monsterdex.ts"
    ,"world-map": "npm run build:battle && node --experimental-strip-types scripts/serve-world-map.ts",
    "build:battle": "node scripts/build-battle-browser.mjs",
    "game": "npm run start --prefix mobile",
    "android": "npm run android --prefix mobile",
    "build:native-assets": "node --experimental-strip-types scripts/build-native-assets.ts",
    "build:native-cards": "node scripts/build-native-cards.mjs",
    "preview": "npm run world-map"
  },
  "engines": {
    "node": ">=22.6"
  }
}
